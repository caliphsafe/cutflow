# -----------------------------------------------------------------------------
# CutFlow v2.3 Production Core
# Add these in Vercel → Project → Settings → Environment Variables.
# Never expose service-role, secret, webhook, encryption or provider-secret values.
# -----------------------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backward-compatible only; prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Backward-compatible only; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Public deployment URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-cutflow-domain.com

# Encrypts Square and other seller OAuth tokens before database storage.
# Must be exactly 32 bytes encoded as 64 hexadecimal characters or base64.
PAYMENT_TOKEN_ENCRYPTION_KEY=

# Stripe platform + Stripe-hosted onboarding for connected barber accounts
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Optional two-letter country lock, for example US. Leave blank to use Stripe/platform defaults.
STRIPE_CONNECTED_ACCOUNT_COUNTRY=US

# CutFlow SaaS subscription price IDs
STRIPE_PRICE_PRO=

# Square and PayPal integrations are intentionally hidden in this release.
# Add their credentials only when those providers are re-enabled and fully tested.

# Transactional email through Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=CutFlow <bookings@your-domain.com>

# Optional SMS through Twilio
NEXT_PUBLIC_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Protects the notification-processing route called by Vercel Cron
CRON_SECRET=

# Platform operations
PLATFORM_ADMIN_EMAIL=

# Optional: email-confirmed Cash App / Venmo / Zelle fallback.
# Use the receiving domain shown in Resend → Emails → Receiving, without @.
# Example: abc123.resend.app or payments.yourdomain.com
RESEND_INBOUND_DOMAIN=
